# Copy the lines you need into your shell environment. Nothing here is required.
# Live mode uses a logged-in local Claude Code, or this key if it is set
# (CLAUDE_CODE_OAUTH_TOKEN is not passed to the agent, so it does not count):
ANTHROPIC_API_KEY=
# Force replay mode (recorded live runs, no login needed):
DEMO_REPLAY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=12
APPROVAL_TIMEOUT_S=300
REPLAY_DELAY_MS=450
EVAL_CONCURRENCY=3
PORT=4102
DATA_DIR=./data
